{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@playa0v0/cyrene-plugin-sdk": ["../packages/plugin-sdk/src/index.ts"],
      "@playa0v0/cyrene-plugin-sdk/testing": ["../packages/plugin-sdk/src/testing/index.ts"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["plugins/**/*.ts", "tests/**/*.ts"]
}
